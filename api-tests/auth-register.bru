meta {
  name: Register User
  type: http
  seq: 5
}

post {
  url: {{BASE_URL}}/{{API_VERSION}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "password": "test123"
  }
}

script:pre-request {
  // Test user registration
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const data = res.body;
    bru.setEnvVar("test_user_id", data.id);
    bru.setEnvVar("test_user_email", data.email);
  }
}

tests {
  test("User registration successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id");
    expect(res.body).to.have.property("email");
    expect(res.body.email).to.equal("test@example.com");
  });
}
