meta {
  name: Update Task - Not Found
  type: http
  seq: 8
}

put {
  url: {{BASE_URL}}/{{API_VERSION}}/tasks/999999
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ access_token }}
}

body:json {
  {
    "title": "This should fail"
  }
}

script:pre-request {
  // Test updating a non-existent task
}

script:post-response {
  // Expected to fail with 404
}

tests {
  test("Returns 404 for non-existent task", function() {
    expect(res.status).to.equal(404);
  });
  
  test("Error message is provided", function() {
    expect(res.body).to.have.property("detail");
    expect(res.body.detail).to.equal("Task not found");
  });
}
