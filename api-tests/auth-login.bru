meta {
  name: Login User
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/{{API_VERSION}}/auth/token?email=test@example.com&password=test123
  body: none
  auth: none
}

script:pre-request {
  // Login using query parameters as expected by FastAPI
}

script:post-response {
  if (res.status === 200) {
    const data = res.body;
    bru.setEnvVar("access_token", data.access_token);
    bru.setEnvVar("token_type", data.token_type);
  }
}

tests {
  test("Login successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("access_token");
    expect(res.body).to.have.property("token_type");
    expect(res.body.token_type).to.equal("bearer");
  });
}
