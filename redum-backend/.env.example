# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change-me-to-a-secure-random-string
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# AI Service Configuration (Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Vector Store Configuration
# Options: chroma, pinecone, pgvector
VECTOR_STORE_TYPE=pgvector

# Chroma Configuration (if VECTOR_STORE_TYPE=chroma)
CHROMA_DB_PATH=./chroma-storage

# Pinecone Configuration (if VECTOR_STORE_TYPE=pinecone)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENV=us-east-1
